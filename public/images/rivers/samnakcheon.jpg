<svg xmlns="http://www.w3.org/2000/svg" width="600" height="360" viewBox="0 0 600 360">
  <defs>
    <linearGradient id="sky" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#F4FAEE"/>
      <stop offset="100%" stop-color="#D6EED0"/>
    </linearGradient>
    <linearGradient id="river" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#2D9CDB"/>
      <stop offset="100%" stop-color="#1B64DA"/>
    </linearGradient>
  </defs>
  <rect width="600" height="360" fill="url(#sky)"/>
  <!-- Reeds / Wetland Grass silhouettes -->
  <path d="M40,240 L50,160 L60,240 M55,240 L70,140 L80,240 M520,240 L535,150 L550,240 M540,240 L560,135 L570,240" stroke="#27AE60" stroke-width="4" stroke-linecap="round" fill="none" opacity="0.6"/>
  <path d="M0,240 Q150,210 300,240 T600,220 L600,360 L0,360 Z" fill="url(#river)"/>
  <text x="300" y="90" dominant-baseline="middle" text-anchor="middle" font-family="'Pretendard', sans-serif" font-size="28" font-weight="800" fill="#1E7E34">🌿 사상 삼락천 생태공원</text>
  <text x="300" y="125" dominant-baseline="middle" text-anchor="middle" font-family="'Pretendard', sans-serif" font-size="16" font-weight="600" fill="#4E5968">낙동강 습지 및 철새 생태 보존 구역</text>
</svg>
