<svg xmlns="http://www.w3.org/2000/svg" width="600" height="360" viewBox="0 0 600 360">
  <defs>
    <linearGradient id="sky" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#EBF8FF"/>
      <stop offset="100%" stop-color="#CBEBFB"/>
    </linearGradient>
    <linearGradient id="mountain" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#27AE60"/>
      <stop offset="100%" stop-color="#1E7E34"/>
    </linearGradient>
    <linearGradient id="river" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#00A8FF"/>
      <stop offset="100%" stop-color="#0066CC"/>
    </linearGradient>
  </defs>
  <rect width="600" height="360" fill="url(#sky)"/>
  <!-- Mountain Silhouette -->
  <polygon points="0,220 180,80 340,200 480,90 600,220 600,360 0,360" fill="url(#mountain)" opacity="0.75"/>
  <path d="M0,230 Q180,200 360,230 T600,210 L600,360 L0,360 Z" fill="url(#river)"/>
  <text x="300" y="60" dominant-baseline="middle" text-anchor="middle" font-family="'Pretendard', sans-serif" font-size="28" font-weight="800" fill="#0066CC">⛰️ 북구 대천천 청정계곡</text>
  <text x="300" y="95" dominant-baseline="middle" text-anchor="middle" font-family="'Pretendard', sans-serif" font-size="16" font-weight="600" fill="#4E5968">금정산 고당봉 1급수 힐링 수변 피서지</text>
</svg>
