<svg xmlns="http://www.w3.org/2000/svg" width="600" height="360" viewBox="0 0 600 360">
  <defs>
    <linearGradient id="sky" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#E8F3FF"/>
      <stop offset="100%" stop-color="#CBE2FF"/>
    </linearGradient>
    <linearGradient id="river" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0%" stop-color="#1B64DA"/>
      <stop offset="100%" stop-color="#0046B8"/>
    </linearGradient>
  </defs>
  <rect width="600" height="360" fill="url(#sky)"/>
  <!-- City skyline silhouette -->
  <rect x="50" y="120" width="40" height="120" fill="#B0C4DE" opacity="0.6"/>
  <rect x="100" y="90" width="55" height="150" fill="#90B2DF" opacity="0.7"/>
  <rect x="170" y="140" width="35" height="100" fill="#B0C4DE" opacity="0.6"/>
  <rect x="420" y="100" width="60" height="140" fill="#90B2DF" opacity="0.7"/>
  <rect x="490" y="130" width="45" height="110" fill="#B0C4DE" opacity="0.6"/>
  <path d="M0,230 Q200,190 400,230 T600,210 L600,360 L0,360 Z" fill="url(#river)"/>
  <text x="300" y="65" dominant-baseline="middle" text-anchor="middle" font-family="'Pretendard', sans-serif" font-size="28" font-weight="800" fill="#0046B8">🏙️ 부산 수영강 수변공원</text>
  <text x="300" y="100" dominant-baseline="middle" text-anchor="middle" font-family="'Pretendard', sans-serif" font-size="16" font-weight="600" fill="#4E5968">APEC 나루공원 및 해운대 야경 경관</text>
</svg>
